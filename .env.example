# JARVIS configuration. Copy to `.env` and fill in.
OPENAI_API_KEY=sk-...
JARVIS_MODEL=gpt-4o
JARVIS_TEMPERATURE=0.1
JARVIS_COMPANY=Acme Industries
JARVIS_DATA_FILE=/home/dayle/enterprise_jarvis/data/jarvis_business.json

# Autonomous layer (guardrails OFF when enabled):
# JARVIS_AUTONOMY=full    critical actions execute WITHOUT human approval
# JARVIS_TRUST_TOOLS=1    generated tools skip the sandbox validation

# Opportunity pipeline (research + invest domain):
# JARVIS_COUNCIL_SIZE=3           independent assessors per idea (2-7)
# JARVIS_VIABILITY_THRESHOLD=75   EPI needed to auto-fund under full autonomy
# JARVIS_MAX_INVESTMENT_SHARE=0.25  max fraction of cash in one autonomous investment
# JARVIS_MAX_INVESTMENT_AMOUNT=0    hard per-idea spend ceiling (0 = no cap)
# JARVIS_EXPOSURE_LIMIT=1           at-risk ventures allowed before the funding
#                                   gate auto-pauses (0 = never auto-pause)
# JARVIS_DISCOVERY=1                autonomous hunt: web research -> council diligence
#                                   -> deploy, inside the opportunity loop (0 = off)
# JARVIS_DISCOVERY_QUERIES=         comma-separated market queries (defaults built-in)
# JARVIS_DISCOVERY_PER_RUN=2        max new ideas logged per opportunity loop run (1-5)
# JARVIS_DISCOVERY_TARGET=6         keep this many proposed+vetted ideas in the pipeline

# Payments rail (defaults to a completely offline simulator):
# JARVIS_REAL_MONEY=simulate    simulate=previews only, real=actual money
# JARVIS_REAL_SPEND_CAP=0       burn-wallet cap for real outbound moves (0 = no cap)
# JARVIS_WEBUI_BIND=127.0.0.1   web dashboard listen address (localhost only)
# JARVIS_WEBUI_PORT=8610        web dashboard port
# STRIPE_SECRET_KEY=sk_live_... billing provider for collect_invoice
# WISE_API_TOKEN=...            payout provider (needs WISE_PROFILE_ID too)
# WISE_PROFILE_ID=...
# WISE_SANDBOX=1                1 = api.sandbox.transferwise.tech, 0/live = production
# PLAID_ACCESS_TOKEN=...        live balance feed for sync_real_balance
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...